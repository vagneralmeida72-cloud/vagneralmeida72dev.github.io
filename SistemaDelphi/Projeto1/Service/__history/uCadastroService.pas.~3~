unit uCadastroService;

interface

uses
  System.SysUtils, System.Variants, Data.DB, uCadastroRepository;

type
  TCadastroService = class
  private
    FRepository: TCadastroRepository;
    FTabela: string;

  public
    constructor Create(pRepository: TCadastroRepository; pTabela: string);

    function F_Inserir(pDataSet: TDataSet): Boolean;
    function F_Alterar(pDataSet: TDataSet): Boolean;
    function FEID: Variant
    ): Boolean;
  end;

implementation

{ TCadastroService }

constructor TCadastroService.Create(
  ARepository: TCadastroRepository;
  const ATabela: string);
begin
  if not Assigned(ARepository) then
    raise Exception.Create(
      'O Repository não foi informado.'
    );

  if Trim(ATabela) = '' then
    raise Exception.Create(
      'A tabela não foi informada.'
    );

  FRepository := ARepository;
  FTabela := Trim(ATabela);
end;

function TCadastroService.Inserir(
  ADataSet: TDataSet): Boolean;
begin
  if not Assigned(ADataSet) then
    raise Exception.Create(
      'O DataSet não foi informado.'
    );

  if ADataSet.State <> dsInsert then
    raise Exception.Create(
      'O DataSet não está em modo de inserção.'
    );

  { Aqui futuramente entram regras de negócio }

  Result :=
    FRepository.Inserir(
      FTabela,
      ADataSet
    );
end;

function TCadastroService.Alterar(
  ADataSet: TDataSet): Boolean;
begin
  if not Assigned(ADataSet) then
    raise Exception.Create(
      'O DataSet não foi informado.'
    );

  if ADataSet.State <> dsEdit then
    raise Exception.Create(
      'O DataSet não está em modo de edição.'
    );

  { Aqui futuramente entram regras de negócio }

  Result :=
    FRepository.Alterar(
      FTabela,
      ADataSet
    );
end;

function TCadastroService.Excluir(
  AID: Variant): Boolean;
begin
  if VarIsNull(AID) or VarIsEmpty(AID) then
    raise Exception.Create(
      'O ID do registro não foi informado.'
    );

  { Aqui futuramente entram regras de negócio }

  Result :=
    FRepository.Excluir(
      FTabela,
      AID
    );
end;

end.
