unit uPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Menus, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, System.Types;

type
  TfrmPrincipal = class(TForm)
    Menu: TMainMenu;
    miConfiguracoes: TMenuItem;
    miSair: TMenuItem;
    miCadastros: TMenuItem;
    miMovimentacoes: TMenuItem;
    miRelatrios: TMenuItem;
    miUsuarios: TMenuItem;
    miClientes: TMenuItem;
    miVendas: TMenuItem;
    RelClientes: TMenuItem;
    RelVendas: TMenuItem;
    imgPrincipal: TImage;
    procedure miSairClick(Sender: TObject);
    procedure miClientesClick(Sender: TObject);
  private
    procedure P_CriaForm(AFormClass: TFormClass);
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

uses
  uClientes;

{$R *.dfm}

procedure TfrmPrincipal.miClientesClick(Sender: TObject);
begin
  P_CriaForm(TfrmCliente);
end;

procedure TfrmPrincipal.miSairClick(Sender: TObject);
begin
  Close;
end;

procedure TfrmPrincipal.P_CriaForm(AFormClass: TFormClass);
var
  vFrm: TForm;
  vP: TPoint;
begin
  vFrm := AFormClass.Create(Self);

  try
    // Posição da área interna do formulário principal
    vP := ClientToScreen(Point(0, 0));

    vFrm.Width  := ClientWidth;
    vFrm.Height := ClientHeight - 2;

    // Posição
    vFrm.Left := vP.X;
    vFrm.Top  := vP.Y + 2;

    // Garante que não ultrapasse a tela pela direita
    if vFrm.Left + vFrm.Width > Screen.WorkAreaLeft + Screen.WorkAreaWidth then
      vFrm.Width := Screen.WorkAreaLeft + Screen.WorkAreaWidth - vFrm.Left;

    // Garante que não ultrapasse a tela por baixo
    if vFrm.Top + vFrm.Height > Screen.WorkAreaTop + Screen.WorkAreaHeight then
      vFrm.Height := Screen.WorkAreaTop + Screen.WorkAreaHeight - vFrm.Top;

    vFrm.BorderStyle := bsNone;
    vFrm.BorderIcons := [];
    vFrm.Position    := poDesigned;
    vFrm.ShowModal;
  finally
    vFrm.Free;
  end;
end;

end.
