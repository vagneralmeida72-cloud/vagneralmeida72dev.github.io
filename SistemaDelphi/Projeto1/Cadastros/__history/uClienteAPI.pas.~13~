unit uClienteAPI;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.DBCtrls, Vcl.ExtCtrls,
  REST.Types, REST.Client, Data.Bind.Components, Data.Bind.ObjectScope, System.JSON,
  FireDAC.Comp.Client, FireDAC.Stan.Param;


type
  TfrmApiCliente = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    btnFechar: TButton;
    btnImportar: TButton;
    RESTClient1: TRESTClient;
    RESTRequest1: TRESTRequest;
    RESTResponse1: TRESTResponse;
    dbmResult: TMemo;
    procedure btnFecharClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure btnImportarClick(Sender: TObject);
  private
    procedure P_LimparLog;
    procedure P_AdicionarLog(pMensagem: string);
    function F_ConsultarAPI(pDocumento: string; var pResultado: string): Boolean;
    function F_ProcessarResultado(pResultado: string): Boolean;
    function F_GravarCliente(pDocumento, pNome, pEmail,
      pTelefone: string): Boolean;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmApiCliente: TfrmApiCliente;

implementation

{$R *.dfm}

uses uDM;

procedure TfrmApiCliente.btnFecharClick(Sender: TObject);
begin
  close;
end;

procedure TfrmApiCliente.P_LimparLog;
begin
  dbmResult.Lines.Clear;
end;

procedure TfrmApiCliente.btnImportarClick(Sender: TObject);
var
  vDocumento, vResultado: string;
begin
  P_LimparLog;
  P_AdicionarLog('========================================');
  P_AdicionarLog('INICIANDO IMPORTAÇÃO');
  P_AdicionarLog('========================================');

  try
    vDocumento := '12345678000199';
    P_AdicionarLog('Documento informado: ' + vDocumento);

    P_AdicionarLog('Preparando consulta REST...');

    if not F_ConsultarAPI(vDocumento, vResultado) then
    begin
      P_AdicionarLog('ERRO: A consulta à API falhou.');
      Exit;
    end;

    P_AdicionarLog('Consulta realizada com sucesso.');
    P_AdicionarLog('Processando resposta da API...');

    if F_ProcessarResultado(vResultado) then
    begin
      P_AdicionarLog('----------------------------------------');
      P_AdicionarLog('IMPORTAÇÃO CONCLUÍDA COM SUCESSO.');
    end
    else
    begin
      P_AdicionarLog('IMPORTAÇÃO NÃO CONCLUÍDA.');
    end;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO GERAL: ' + E.Message);
    end;
  end;

  P_AdicionarLog('========================================');
  P_AdicionarLog('FIM DA IMPORTAÇÃO');
  P_AdicionarLog('========================================');
end;

procedure TfrmApiCliente.FormCreate(Sender: TObject);
begin
  P_LimparLog;
  P_AdicionarLog('========================================');
  P_AdicionarLog('      INTEGRAÇÃO API - CLIENTE');
  P_AdicionarLog('========================================');
  P_AdicionarLog('Sistema iniciado.');
  P_AdicionarLog('Aguardando importação...');
end;

procedure TfrmApiCliente.P_AdicionarLog(pMensagem: string);
begin
  dbmResult.Lines.Add(FormatDateTime('[dd/mm/yyyy hh:nn:ss]', Now) + pMensagem);
end;

function TfrmApiCliente.F_ConsultarAPI(pDocumento: string; var pResultado: string): Boolean;
begin
  Result := False;
  pResultado := '';

  try
    RESTClient1.BaseURL := 'http://localhost:8080';
    RESTRequest1.Resource := '/cliente';
    RESTRequest1.Method := rmGET;
    RESTRequest1.Response := RESTResponse1;

    // Limpa parâmetros anteriores
    RESTRequest1.Params.Clear;

    // Envia:
    RESTRequest1.AddParameter('documento', pDocumento, pkGETorPOST);

    P_AdicionarLog('URL: ' + RESTClient1.BaseURL + RESTRequest1.Resource +
      '?documento=' + pDocumento);

    P_AdicionarLog('Método: GET');
    P_AdicionarLog('Executando requisição...');

    RESTRequest1.Execute;

    P_AdicionarLog('HTTP Status: ' + IntToStr(RESTResponse1.StatusCode));

    if RESTResponse1.StatusCode <> 200 then
    begin
      P_AdicionarLog('ERRO HTTP: ' + RESTResponse1.StatusText);
      P_AdicionarLog('Resposta: ' + RESTResponse1.Content);
      Exit;
    end;

    pResultado := RESTResponse1.Content;

    if Trim(pResultado) = '' then
    begin
      P_AdicionarLog('ERRO: A API retornou resposta vazia.');
      Exit;
    end;

    P_AdicionarLog('Resposta recebida.');
    P_AdicionarLog('JSON recebido:');
    P_AdicionarLog(pResultado);

    Result := True;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO REST: ' + E.Message);
      Result := False;
    end;
  end;
end;

function TfrmApiCliente.F_ProcessarResultado(pResultado: string): Boolean;
var
  JSONValue: TJSONValue;
  JSONObject: TJSONObject;
  ClienteJSON: TJSONObject;
  vSucesso: Boolean;
  vMensagem, vDocumento, vNome, vEmail, vTelefone: string;
begin
  Result := False;
  JSONValue := nil;
  try
    P_AdicionarLog('Validando JSON...');

    JSONValue := TJSONObject.ParseJSONValue(pResultado);

    if not Assigned(JSONValue) then
    begin
      P_AdicionarLog('ERRO: JSON inválido.');
      Exit;
    end;

    if not (JSONValue is TJSONObject) then
    begin
      P_AdicionarLog('ERRO: Retorno não é um objeto JSON.');
      Exit;
    end;

    JSONObject := JSONValue as TJSONObject;

    // RESULTADO DA API
    vSucesso  := JSONObject.GetValue<Boolean>('sucesso');
    vMensagem := JSONObject.GetValue<string>('mensagem');

    P_AdicionarLog('Mensagem da API: ' + vMensagem);

    if not vSucesso then
    begin
      P_AdicionarLog('API informou que a consulta não foi realizada.');
      Exit;
    end;

    // OBJETO CLIENTE
    ClienteJSON := JSONObject.GetValue<TJSONObject>('cliente');
    if not Assigned(ClienteJSON) then
    begin
      P_AdicionarLog('ERRO: Objeto "cliente" não encontrado no JSON.');
      Exit;
    end;

    // CAMPOS DO CLIENTE
    vDocumento := ClienteJSON.GetValue<string>('documento');
    vNome      := ClienteJSON.GetValue<string>('nome');
    vEmail     := ClienteJSON.GetValue<string>('email');
    vTelefone  := ClienteJSON.GetValue<string>('telefone');

    // MOSTRA OS DADOS
    P_AdicionarLog('----------------------------------------');
    P_AdicionarLog('CLIENTE RECEBIDO DA API');
    P_AdicionarLog('Documento: ' + vDocumento);
    P_AdicionarLog('Nome: ' + vNome);
    P_AdicionarLog('E-mail: ' + vEmail);
    P_AdicionarLog('Telefone: ' + vTelefone);
    P_AdicionarLog('----------------------------------------');
    P_AdicionarLog('Cliente recebido corretamente.');

    if not F_GravarCliente(vDocumento, vNome, vEmail, vTelefone) then
    begin
      P_AdicionarLog('ERRO: Cliente não foi gravado.');
      Exit;
    end;
    P_AdicionarLog('Cliente gravado com sucesso.');

    Result := True;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO AO PROCESSAR JSON: ' + E.Message);
      Result := False;
    end;
  end;
  JSONValue.Free;
end;

function TfrmApiCliente.F_GravarCliente(pDocumento, pNome, pEmail,
  pTelefone: string): Boolean;
var
  vQuery: TFDQuery;
  vExiste: Boolean;
begin
  vQuery := TFDQuery.Create(nil);

  try
    vQuery.Connection := DM.FDConnection;
    P_AdicionarLog('Verificando se o cliente já existe...');

    vQuery.Close;
    vQuery.SQL.Clear;
    vQuery.SQL.Add('SELECT COUNT(*) AS QTDE FROM CLIENTE WHERE DOCUMENTO = :DOCUMENTO');
    vQuery.ParamByName('DOCUMENTO').AsString := pDocumento;
    vQuery.Open;

    vExiste := vQuery.FieldByName('QTDE').AsInteger > 0;
    vQuery.Close;

    DM.FDConnection.StartTransaction;

    try
      // CLIENTE JÁ EXISTE
      if vExiste then
      begin
        P_AdicionarLog('Cliente já existe.');
        P_AdicionarLog('Atualizando cadastro...');

        vQuery.Close;
        vQuery.SQL.Clear;

        vQuery.SQL.Add('UPDATE CLIENTE SET NOME = :NOME, ' +
          'EMAIL = :EMAIL, TELEFONE = :TELEFONE ' +
          'WHERE DOCUMENTO = :DOCUMENTO ;');

      vQuery.ParamByName('DOCUMENTO').AsString := pDocumento;
        vQuery.ParamByName('NOME').AsString      := pNome;
        vQuery.ParamByName('EMAIL').AsString     := pEmail;
        vQuery.ParamByName('TELEFONE').AsString  := pTelefone;

        vQuery.ExecSQL;

        P_AdicionarLog('Cliente atualizado com sucesso.');
      end
      else
      begin
        P_AdicionarLog('Cliente não encontrado.');
        P_AdicionarLog('Inserindo novo cliente...');
        vQuery.Close;
        vQuery.SQL.Clear;

        vQuery.SQL.Add('INSERT INTO CLIENTE (DOCUMENTO, NOME, EMAIL, TELEFONE)');
        vQuery.SQL.Add(' VALUES (:DOCUMENTO, :NOME, :EMAIL, :TELEFONE);');

        vQuery.ParamByName('DOCUMENTO').AsString := pDocumento;
        vQuery.ParamByName('NOME').AsString      := pNome;
        vQuery.ParamByName('EMAIL').AsString     := pEmail;
        vQuery.ParamByName('TELEFONE').AsString  := pTelefone;

        vQuery.ExecSQL;

        P_AdicionarLog('Novo cliente inserido com sucesso.');
      end;

      DM.FDConnection.Commit;
      Result := True;
    except
      on E: Exception do
      begin
        if DM.FDConnection.InTransaction then
          DM.FDConnection.Rollback;

        P_AdicionarLog('ERRO AO GRAVAR CLIENTE: ' + E.Message);
        Result := False;
      end;
    end;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO DE BANCO: ' + E.Message );
      Result := False;
    end;
  end;
  vQuery.Free;
end;

end.
