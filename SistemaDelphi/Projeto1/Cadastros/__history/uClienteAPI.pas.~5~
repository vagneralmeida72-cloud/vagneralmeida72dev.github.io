procedure TfrmApiCliente.P_AdicionarLog(pMensagem: string);
begin
  dbmResult.Lines.Add(FormatDateTime('[dd/mm/yyyy hh:nn:ss]', Now) + pMensagem);
end;

function TfrmApiCliente.F_ConsultarAPI(pDocumento, pResultado: string): Boolean;
begin
  Result := False;
  pResultado := '';

  try

    {
      ======================================================
      CONFIGURAÇÃO DO REST CLIENT
      ======================================================

      Quando tivermos a API real, vamos colocar aqui:

      RESTClient1.BaseURL :=
        'https://endereco-da-api.com';

      RESTRequest1.Resource :=
        '/cliente/' + ADocumento;

      ======================================================
    }

    RESTClient1.BaseURL   := 'https://jsonplaceholder.typicode.com';
    RESTRequest1.Resource := '/users/1';
    RESTRequest1.Method   := rmGET;
    RESTRequest1.Response := RESTResponse1;

    P_AdicionarLog('URL: ' + RESTClient1.BaseURL + RESTRequest1.Resource);
    P_AdicionarLog('Método: GET');
    P_AdicionarLog('Executando requisição...');

    RESTRequest1.Execute;

    //Verifica código HTTP
    P_AdicionarLog('HTTP Status: ' + IntToStr(RESTResponse1.StatusCode));

    if RESTResponse1.StatusCode <> 200 then
    begin
      P_AdicionarLog('ERRO HTTP: ' + RESTResponse1.StatusText);
      Exit;
    end;

    //Obtém JSON retornado
    pResultado := RESTResponse1.Content;

    if Trim(pResultado) = '' then
    begin
      P_AdicionarLog('ERRO: A API retornou resposta vazia.');
      Exit;
    end;
    P_AdicionarLog('Resposta recebida.');
    Result := True;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO REST: ' + E.Message);
      Result := False;
    end;
  end;
end;

function TfrmApiCliente.F_ProcessarResultado(pResultado: string): Boolean;
var
  JSONValue: TJSONValue;
  JSONObject: TJSONObject;
  vID: Integer;
  vNome, vEmail, vTelefone: string;
begin
  Result := False;
  JSONValue := nil;
  try
    P_AdicionarLog('Validando JSON...');
    JSONValue := TJSONObject.ParseJSONValue(pResultado);
    if not Assigned(JSONValue) then
    begin
      P_AdicionarLog('ERRO: JSON inválido.');
      Exit;
    end;

    if not (JSONValue is TJSONObject) then
    begin
      P_AdicionarLog('ERRO: Retorno não é um objeto JSON.');
      Exit;
    end;

    JSONObject := JSONValue as TJSONObject;

    vID       := JSONObject.GetValue<Integer>('id');
    vNome     := JSONObject.GetValue<string>('name');
    vEmail    := JSONObject.GetValue<string>('email');
    vTelefone := JSONObject.GetValue<string>('phone');

    P_AdicionarLog('----------------------------------------');
    P_AdicionarLog('CLIENTE RECEBIDO DA API');
    P_AdicionarLog('ID: ' + IntToStr(vID));
    P_AdicionarLog('Nome: ' + vNome);
    P_AdicionarLog('E-mail: ' + vEmail);
    P_AdicionarLog('Telefone: ' + vTelefone);
    P_AdicionarLog('----------------------------------------');

    if not F_GravarCliente(vID, vNome, vEmail, vTelefone) then
    begin
      P_AdicionarLog( 'ERRO: Cliente não foi gravado.' );
      Exit;
    end;

    P_AdicionarLog('Cliente gravado com sucesso.');
    Result := True;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO AO PROCESSAR JSON: ' + E.Message);
      Result := False;
    end;
  end;
  JSONValue.Free;
end;

function TfrmApiCliente.F_GravarCliente(pID: Integer; pNome, pEmail,
  pTelefone: string): Boolean;
var
  vQuery: TFDQuery;
  vExiste: Boolean;
begin
  vQuery := TFDQuery.Create(nil);

  try
    vQuery.Connection := DM.FDConnection;

    P_AdicionarLog('Verificando se cliente já existe...');
    vQuery.Close;
    vQuery.SQL.Clear;
    vQuery.SQL.Add('SELECT COUNT(*) AS QTDE FROM CLIENTE WHERE ID_API = :ID_API');
    vQuery.ParamByName('ID_API').AsInteger := pID;
    vQuery.Open;
    vExiste := vQuery.FieldByName('QTDE').AsInteger > 0;
    vQuery.Close;

    DM.FDConnection.StartTransaction;
    try
      //SE EXISTIR, ATUALIZA
      if vExiste then
      begin
        P_AdicionarLog('Cliente já existe.');
        P_AdicionarLog('Atualizando cadastro...');
        vQuery.SQL.Clear;
        vQuery.SQL.Add('UPDATE CLIENTE SET ');
        vQuery.SQL.Add('NOME = :NOME, ');
        vQuery.SQL.Add('EMAIL = :EMAIL, ');
        vQuery.SQL.Add('TELEFONE = :TELEFONE ');
        vQuery.SQL.Add('WHERE ID_API = :ID_API');

        vQuery.ParamByName('ID_API').AsInteger  := pID;
        vQuery.ParamByName('NOME').AsString     := pNome;
        vQuery.ParamByName('EMAIL').AsString    := pEmail;
        vQuery.ParamByName('TELEFONE').AsString := pTelefone;
        vQuery.ExecSQL;

        P_AdicionarLog('Cliente atualizado.');
      end
      else
      begin
        //SE NÃO EXISTIR, INSERE
        P_AdicionarLog('Cliente não encontrado.');
        P_AdicionarLog('Inserindo novo cliente...');

        vQuery.SQL.Clear;
        vQuery.SQL.Add('INSERT INTO CLIENTE (ID_API, NOME, EMAIL, TELEFONE)');
        vQuery.SQL.Add(' VALUES (:ID_API, :NOME, :EMAIL, :TELEFONE);');

        vQuery.ParamByName('ID_API').AsInteger  := pID;
        vQuery.ParamByName('NOME').AsString     := pNome;
        vQuery.ParamByName('EMAIL').AsString    := pEmail;
        vQuery.ParamByName('TELEFONE').AsString := pTelefone;
        vQuery.ExecSQL;

        P_AdicionarLog('Novo cliente inserido.');
      end;
      DM.FDConnection.Commit;
      Result := True;
    except
      on E: Exception do
      begin
        if DM.FDConnection.InTransaction then
          DM.FDConnection.Rollback;

        P_AdicionarLog('ERRO AO GRAVAR CLIENTE: ' + E.Message);
        Result := False;
      end;
    end;
  except
    on E: Exception do
    begin
      P_AdicionarLog('ERRO DE BANCO: ' + E.Message );
      Result := False;
    end;
  end;
  vQuery.Free;
end;

end.
