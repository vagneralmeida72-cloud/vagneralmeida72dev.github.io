unit uUpdate;

interface

uses
  FireDAC.Comp.Client;

type
  TUpdate = class
  private
    class procedure P_Update001(pUpdate: TObject);
    class procedure P_Update002(pUpdate: TObject);
  public
    class procedure Executar(pConnection: TFDConnection);
  end;

implementation

uses
  uLibFuncoesUpdate;

class procedure TUpdate.Executar(pConnection: TFDConnection);
var
  vUpdate: TDatabaseUpdate;
begin
  vUpdate := TDatabaseUpdate.Create(pConnection);
  try
    P_Update001(vUpdate);
    P_Update002(vUpdate);
  finally
    vUpdate.Free;
  end;
end;

class procedure TUpdate.P_Update001(pUpdate: TObject);
begin
  // Cria a tabela CLIENTE caso não exista
  if not pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    pUpdate.Connection.ExecSQL('CREATE TABLE CLIENTE (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL, ' +
      'NOME VARCHAR(100), ' +
      'CPF VARCHAR(14), ' +
      'EMAIL VARCHAR(150), ' +
      'TELEFONE VARCHAR(20), ' +
      'CONSTRAINT PK_CLIENTE PRIMARY KEY (ID)' +
      ');');
  end;
  if pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    if not pUpdate.F_CampoExiste('CLIENTE', 'DATA_CADASTRO') then
      pUpdate.Connection.ExecSQL('ALTER TABLE CLIENTE ADD DATA_CADASTRO TIMESTAMP;');
  end;
end;

class procedure TUpdate.P_Update002(pUpdate: TObject);
begin
  // Bloco 002
end;

end.
