unit uUpdate;

interface

uses
  FireDAC.Comp.Client,
  uLibFuncoesUpdate;

type
  TUpdate = class
  private
    class procedure Update001(
      pUpdate: TDatabaseUpdate
    );

  public
    class procedure Executar(
      pConnection: TFDConnection
    );
  end;

implementation

class procedure TUpdate.Update001(
  pUpdate: TDatabaseUpdate
);
begin
  // Cria a tabela CLIENTE caso não exista
  if not pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    pUpdate.Connection.ExecSQL(
      'CREATE TABLE CLIENTE (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL, ' +
      'NOME VARCHAR(100), ' +
      'CPF VARCHAR(14), ' +
      'EMAIL VARCHAR(150), ' +
      'TELEFONE VARCHAR(20), ' +
      'CONSTRAINT PK_CLIENTE PRIMARY KEY (ID)' +
      ')'
    );
  end;
end;

class procedure TUpdate.Executar(
  pConnection: TFDConnection
);
var
  Update: TDatabaseUpdate;
begin
  Update := TDatabaseUpdate.Create(
    pConnection
  );

  try
    Update001(Update);
  finally
    Update.Free;
  end;
end;

end.
