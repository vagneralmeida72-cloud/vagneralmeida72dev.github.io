unit uUpdate;

interface

uses
  FireDAC.Comp.Client,
  uLibFuncoesUpdate;

type
  TUpdate = class
  private
    class procedure P_Update001(pUpdate: TDatabaseUpdate);
  public
    class procedure Executar(pConnection: TFDConnection);
  end;

implementation

class procedure TUpdate.P_Update001(
  pUpdate: TDatabaseUpdate
);
begin

  // ==========================================================
  // 1 - CRIA TABELA CLIENTE
  // ==========================================================

  if not pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    pUpdate.Connection.ExecSQL(
      'CREATE TABLE CLIENTE (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL, ' +
      'NOME VARCHAR(100), ' +
      'CPF VARCHAR(14), ' +
      'EMAIL VARCHAR(150), ' +
      'TELEFONE VARCHAR(20), ' +
      'CONSTRAINT PK_CLIENTE PRIMARY KEY (ID)' +
      ')'
    );
  end;


  // ==========================================================
  // 2 - ADICIONA DATA_CADASTRO
  // ==========================================================

  if pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    if not pUpdate.F_CampoExiste(
      'CLIENTE',
      'DATA_CADASTRO'
    ) then
    begin
      pUpdate.Connection.ExecSQL(
        'ALTER TABLE CLIENTE ' +
        'ADD DATA_CADASTRO TIMESTAMP'
      );
    end;
  end;


  // ==========================================================
  // 3 - ADICIONA ATIVO
  // ==========================================================

  if pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    if not pUpdate.F_CampoExiste(
      'CLIENTE',
      'ATIVO'
    ) then
    begin
      pUpdate.Connection.ExecSQL(
        'ALTER TABLE CLIENTE ' +
        'ADD ATIVO SMALLINT'
      );
    end;
  end;


  // ==========================================================
  // 4 - ADICIONA OBSERVACAO
  // ==========================================================

  if pUpdate.F_TabelaExiste('CLIENTE') then
  begin
    if not pUpdate.F_CampoExiste(
      'CLIENTE',
      'OBSERVACAO'
    ) then
    begin
      pUpdate.Connection.ExecSQL(
        'ALTER TABLE CLIENTE ' +
        'ADD OBSERVACAO VARCHAR(500)'
      );
    end;
  end;

end;


class procedure TUpdate.Executar(
  pConnection: TFDConnection
);
var
  vUpdate: TDatabaseUpdate;
begin

  vUpdate := TDatabaseUpdate.Create(pConnection);

  try

    // Executa o bloco 001
    P_Update001(vUpdate);

  finally

    vUpdate.Free;

  end;

end;

end.
