unit uUpdate;

interface

uses
  FireDAC.Comp.Client, uDatabaseUpdate;

type
  TUpdate001 = class
  public
    class procedure Executar(pUpdate: TDatabaseUpdate);
  end;

implementation

{ TUpdate001 }

class procedure TUpdate001.Executar(pUpdate: TDatabaseUpdate);
begin
  if not pUpdate.TabelaExiste('CLIENTE') then
  begin
    pUpdate.Connection.ExecSQL(
      'CREATE TABLE CLIENTE (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL, ' +
      'NOME VARCHAR(100), ' +
      'CPF VARCHAR(14), ' +
      'EMAIL VARCHAR(150), ' +
      'TELEFONE VARCHAR(20), ' +
      'CONSTRAINT PK_CLIENTE PRIMARY KEY (ID)' +
      ')'
    );
  end;
end;

end.
