unit uLibFuncoesUpdate;

interface

uses
  FireDAC.Comp.Client;

type
  TDatabaseUpdate = class
  private
    FConnection: TFDConnection;

  public
    constructor Create(
      pConnection: TFDConnection
    );

    function TabelaExiste(
      const pTabela: string
    ): Boolean;

    function CampoExiste(
      const pTabela,
      pCampo: string
    ): Boolean;

    procedure Executar;
  end;

implementation

uses
  System.SysUtils, uUpdate;

constructor TDatabaseUpdate.Create(
  pConnection: TFDConnection
);
begin
  FConnection := pConnection;
end;

function TDatabaseUpdate.TabelaExiste(
  const pTabela: string
): Boolean;
begin
  Result :=
    FConnection.ExecSQLScalar(
      'SELECT COUNT(*) ' +
      'FROM RDB$RELATIONS ' +
      'WHERE RDB$RELATION_NAME = :NOME',
      [UpperCase(pTabela)]
    ) > 0;
end;

function TDatabaseUpdate.CampoExiste(
  const pTabela,
  pCampo: string
): Boolean;
begin
  Result :=
    FConnection.ExecSQLScalar(
      'SELECT COUNT(*) ' +
      'FROM RDB$RELATION_FIELDS ' +
      'WHERE RDB$RELATION_NAME = :TABELA ' +
      'AND RDB$FIELD_NAME = :CAMPO',
      [
        UpperCase(pTabela),
        UpperCase(pCampo)
      ]
    ) > 0;
end;

procedure TDatabaseUpdate.Executar;
begin
  TUpdate001.Executar(Self);
  TUpdate002.Executar(Self);
end;

end.
