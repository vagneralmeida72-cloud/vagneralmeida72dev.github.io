unit uFrmIA;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs,
  Vcl.StdCtrls, Vcl.ExtCtrls, System.JSON, System.Net.HttpClient,
  System.Net.URLClient, uIA, uIAConfig, libFuncoes;

type
  TfrmIA = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    lblPergunta: TLabel;
    lblResposta: TLabel;
    memPergunta: TMemo;
    memResposta: TMemo;
    btnPerguntar: TButton;
    btnSair: TButton;
    procedure btnSairClick(Sender: TObject);
    procedure btnPerguntarClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmIA: TfrmIA;

implementation

{$R *.dfm}

procedure TfrmIA.btnPerguntarClick(Sender: TObject);
var
  vIA: TIA;
  vConfig: TIAConfig;
begin
  memResposta.clear;
  if Trim(memPergunta.Text) = '' then
  begin
    F_Mensagem('Digite uma pergunta.', tmAviso);
    Exit;
  end;

  vConfig := ObterConfigIA;
  vIA := TIA.Create(vConfig);

  try
    memResposta.Lines.Text := vIA.F_Perguntar(memPergunta.Text);
  finally
    vIA.Free;
  end;
end;

procedure TfrmIA.btnSairClick(Sender: TObject);
begin
  Close;
end;

procedure TfrmIA.FormCreate(Sender: TObject);
begin
  memPergunta.clear;
  memResposta.clear;
end;

end.
