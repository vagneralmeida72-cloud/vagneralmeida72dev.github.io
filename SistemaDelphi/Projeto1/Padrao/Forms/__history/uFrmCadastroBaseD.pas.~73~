begin
  Result := F_ValidarCamposObrigatoriosEm(pnlCadastro2,
    'Preencha os campos obrigatórios do item!');
end;

procedure TfrmCadastroBaseD.P_ConfigurarDetalhes(pSQL, pTabelaDetalhe,
  pCampoFK: string);
begin
  if Trim(pSQL) = '' then
    raise Exception.Create('O SQL dos detalhes não foi informado.');

  if Trim(pTabelaDetalhe) = '' then
    raise Exception.Create('A tabela de detalhes não foi informada.');

  if Trim(pCampoFK) = '' then
    raise Exception.Create('O campo de relacionamento não foi informado.');

  cdsCadastroDetail.Close;
  qryCadastroDetail.Close;

  FSQLDetailOriginal := Trim(pSQL);
  FTabelaDetail := Trim(pTabelaDetalhe);
  FCampoFK := Trim(pCampoFK);

  qryCadastroDetail.SQL.Text := FSQLDetailOriginal;

  if qryCadastroDetail.Params.FindParam('P_ID') = nil then
    raise Exception.Create('O SQL dos detalhes precisa conter o parâmetro :P_ID.');

  dspCadastroDetail.DataSet := qryCadastroDetail;
  cdsCadastroDetail.SetProvider(dspCadastroDetail);

  FDetalhesConfigurados := True;

  P_RecarregarDetalhes;
end;

procedure TfrmCadastroBaseD.P_RecarregarDetalhes;
var
  vID: Variant;
begin
  if not FDetalhesConfigurados then
    Exit;

  if cdsCadastroDetail.Active then
  begin
    if cdsCadastroDetail.State in [dsInsert, dsEdit] then
      cdsCadastroDetail.Cancel;
    cdsCadastroDetail.Close;
  end;

  qryCadastroDetail.Close;

  if cdsCadastro.State in [dsInsert, dsEdit] then
    vID := -1
  else if Assigned(cdsCadastro.FindField('ID')) and not cdsCadastro.IsEmpty then
    vID := cdsCadastro.FieldByName('ID').Value
  else
    vID := -1;

  qryCadastroDetail.SQL.Text := FSQLDetailOriginal;

  if qryCadastroDetail.Params.FindParam('P_ID') = nil then
    raise Exception.Create('O SQL dos detalhes precisa conter o parâmetro :P_ID.');

  qryCadastroDetail.ParamByName('P_ID').Value := vID;

  // Configura o Provider.
  dspCadastroDetail.DataSet := qryCadastroDetail;
  cdsCadastroDetail.SetProvider(dspCadastroDetail);

  // Abre o ClientDataSet através do Provider.
  cdsCadastroDetail.Open;
  P_ConfigurarCampoIDDetail;

  if not cdsCadastroDetail.Active then
    raise Exception.Create('Não foi possível abrir o cdsCadastroDetail.');

  P_AcaoBotoesDetail(False);
end;

procedure TfrmCadastroBaseD.P_ConfigurarControles(AParent: TWinControl;
  pEdicao: Boolean);
var
  I: Integer;
  C: TControl;
begin
  if not Assigned(AParent) then
    Exit;

  for I := 0 to AParent.ControlCount - 1 do
  begin
    C := AParent.Controls[I];

    // Percorre os contêineres internos.
    if C is TWinControl then
      P_ConfigurarControles(TWinControl(C), pEdicao);

    if C is TDBEdit then
      TDBEdit(C).Enabled := pEdicao
    else if C is TDBMemo then
      TDBMemo(C).Enabled := pEdicao
    else if C is TDBComboBox then
      TDBComboBox(C).Enabled := pEdicao
    else if C is TDBLookupComboBox then
      TDBLookupComboBox(C).Enabled := pEdicao
    else if C is TEdit then
      TEdit(C).Enabled := pEdicao
    else if C is TMemo then
      TMemo(C).Enabled := pEdicao
    else if C is TComboBox then
      TComboBox(C).Enabled := pEdicao
    else if C is TCheckBox then
      TCheckBox(C).Enabled := pEdicao
    else if C is TLabel then
      TLabel(C).Enabled := pEdicao;
  end;
end;

procedure TfrmCadastroBaseD.P_AtualizarEstadoDetail;
var
  vEdicao: Boolean;
begin
  if not Assigned(cdsCadastroDetail) then
    Exit;

  vEdicao := cdsCadastroDetail.State in [dsInsert, dsEdit];

  P_ConfigurarControles(pnlCadastro2, vEdicao);

  pnlCadastro2.Enabled := vEdicao;
end;

procedure TfrmCadastroBaseD.P_ConfigurarCampoIDDetail;
var
  vCampo: TField;
  vDef: TFieldDef;
begin
  if not cdsCadastroDetail.Active then
    Exit;

  // ID: gerado pelo banco de dados.
  vCampo := cdsCadastroDetail.FindField('ID');

  if Assigned(vCampo) then
  begin
    vCampo.Required := False;
    vCampo.ReadOnly := True;
    vCampo.AutoGenerateValue := arAutoInc;
  end;

  vDef := cdsCadastroDetail.FieldDefs.Find('ID');
  if Assigned(vDef) then
    vDef.Required := False;

  // Chave estrangeira: será preenchida antes de salvar no banco.
  if Trim(FCampoFK) <> '' then
  begin
    vCampo := cdsCadastroDetail.FindField(FCampoFK);

    if Assigned(vCampo) then
      vCampo.Required := False;

    vDef := cdsCadastroDetail.FieldDefs.Find(FCampoFK);
    if Assigned(vDef) then
      vDef.Required := False;
  end;
end;

