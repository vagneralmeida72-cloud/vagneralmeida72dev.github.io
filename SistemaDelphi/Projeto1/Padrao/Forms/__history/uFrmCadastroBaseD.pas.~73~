function TfrmCadastroBaseD.F_ValidarCamposObrigatoriosEm(pParent: TWinControl;
  pMensagem: string): Boolean;
var
  vPrimeiro: TWinControl;
begin
  Result    := True;
  vPrimeiro := nil;

  if not Assigned(pParent) then
    Exit;

  P_ValidarControlesObrigatorios(pParent, vPrimeiro, Result);

  if not Result then
  begin
    F_Mensagem(pMensagem, tmAviso);

    if Assigned(vPrimeiro) and vPrimeiro.Visible and vPrimeiro.Enabled and
       vPrimeiro.CanFocus then
      vPrimeiro.SetFocus;
  end;
end;

function TfrmCadastroBaseD.F_ValidarCadastroPrincipal: Boolean;
begin
