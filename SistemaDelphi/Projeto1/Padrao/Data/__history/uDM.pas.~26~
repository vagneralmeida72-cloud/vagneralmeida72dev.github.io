procedure TDM.P_Conectar;
var
PastaBanco: string;
ArquivoBanco: string;
begin
PastaBanco := TPath.Combine(
ExtractFilePath(ParamStr(0)),
'Banco'
);

ArquivoBanco := TPath.Combine(
PastaBanco,
'SISTEMACLIENTE.FDB'
);

// Cria a pasta Banco
if not TDirectory.Exists(PastaBanco) then
TDirectory.CreateDirectory(PastaBanco);

// Fecha a conexão caso esteja aberta
if FDConnection.Connected then
FDConnection.Close;

// Configuração Firebird
FDConnection.DriverName := 'FB';

FDConnection.Params.Clear;

FDConnection.Params.Add('DriverID=FB');
FDConnection.Params.Add('Database=' + ArquivoBanco);
FDConnection.Params.Add('User_Name=SYSDBA');
FDConnection.Params.Add('Password=masterkey');
FDConnection.Params.Add('CharacterSet=UTF8');

FDConnection.LoginPrompt := False;

// Cria o banco caso não exista
if not TFile.Exists(ArquivoBanco) then
FDConnection.Params.Add('OpenMode=Create');

try
FDConnection.Open;
P_CriarEstrutura;
except
on E: Exception do
begin
raise Exception.Create(
'Erro ao conectar ao banco de dados.' +
sLineBreak + sLineBreak +
'Banco:' +
sLineBreak +
ArquivoBanco +
sLineBreak + sLineBreak +
E.Message
);
end;
end;
end;

procedure TDM.P_CriarEstrutura;
begin
  // Cria a tabela CLIENTE se não existir
  if P_TabelaExiste('CLIENTE') then
  begin
    FDConnection.ExecSQL('DROP TABLE CLIENTE;'
    );
  end;
  if not P_TabelaExiste('CLIENTE') then
  begin
    FDConnection.ExecSQL(
      'CREATE TABLE CLIENTE (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL, ' +
      'NOME VARCHAR(100), ' +
      'CPF VARCHAR(14), ' +
      'EMAIL VARCHAR(150), ' +
      'TELEFONE VARCHAR(20),' +
      'CONSTRAINT PK_CLIENTE PRIMARY KEY (ID)' +
      ')'
    );
  end;

