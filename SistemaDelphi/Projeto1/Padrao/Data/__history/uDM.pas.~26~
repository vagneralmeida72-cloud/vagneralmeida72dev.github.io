function TDM.P_TabelaExiste(const pTabela: string): Boolean;
begin
  Result :=
    FDConnection.ExecSQLScalar(
      'SELECT COUNT(*) ' +
      'FROM RDB$RELATIONS ' +
      'WHERE RDB$RELATION_NAME = :NOME',
      [UpperCase(pTabela)]
    ) > 0;
end;

